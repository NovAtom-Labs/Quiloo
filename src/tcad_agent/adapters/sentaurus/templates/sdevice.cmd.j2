// Generated by NovAtom TCAD Agent Sentaurus compiler {{ compiler_version }}.
// Input is a validated portable specification. Do not edit this file.
Electrode {
{% for contact in contacts %}  { Name="{{ contact.id }}" Voltage=0{% if contact.work_function is not none %} WorkFunction={{ contact.work_function }}{% endif %} }
{% endfor %}}

File {
  Grid="device.tdr"
  Plot="sdevice.tdr"
  Current="sdevice.plt"
  Output="sdevice.log"
}

Physics {
  Temperature={{ temperature }}
{% for line in physics_lines %}  {{ line }}
{% endfor %}}

Plot {
{% for field in plot_fields %}  {{ field }}
{% endfor %}}

Math {
  Extrapolate
  RelErrControl
  Digits=5
  Iterations=50
}

Solve {
  Coupled { Poisson Electron Hole }
{% if study.kind == "dc" %}  Quasistationary(
    InitialStep={{ study.step }} MinStep=1e-6 MaxStep={{ study.step }}
    Goal { Name="{{ study.contact }}" Voltage={{ study.stop }} }
  ) { Coupled { Poisson Electron Hole } }
{% endif %}}
